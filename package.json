{
  "name": "3d-tetolis",
  "private": true,
  "version": "0.1.0",
  "description": "4×4のピットに立体テトロミノを積む3Dテトリス。視点を90°ずつ回して4方向から確認できる。",
  "license": "MIT",
  "author": "mikami",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
